<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- GameDay talks HTTPS only. No user-installed CAs are trusted for its own traffic. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
