<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.GameDay" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/gd_bg</item>
        <item name="android:colorAccent">@color/gd_accent</item>
        <item name="android:colorPrimary">@color/gd_bg</item>
        <item name="android:colorPrimaryDark">@color/gd_bg</item>
        <item name="android:textColorPrimary">@color/gd_text</item>
        <item name="android:textColorSecondary">@color/gd_text_muted</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.GameDay.Splash" parent="Theme.GameDay">
        <item name="android:windowBackground">@color/gd_bg</item>
    </style>

</resources>
