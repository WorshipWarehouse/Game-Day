<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Networking is used only for GameDay's own release feed and for integrity-checked downloads. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Needed only when the user chooses to install a verified APK by hand. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Best-effort "stop the guest" support; a normal permission, no user prompt. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!--
      One APK, two seatings: Fire TV (leanback launcher, D-pad) and phone/tablet (touch launcher).
      No activity pins an orientation, so a phone can rotate while a television, which never does,
      is unaffected. The theme is fullscreen; the touch layout restores the system bars at runtime.
    -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!--
      Android 11+ package visibility: GameDay must be able to see the NFL app it hosts and the
      Amazon Appstore it delegates installs and updates to.
    -->
    <queries>
        <package android:name="com.gotv.nflgamecenter.us.lite" />
        <package android:name="com.amazon.venezia" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="amzn" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".GameDayApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.GameDay"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.StartupActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.GameDay.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.HomeActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode"
            android:exported="false" />

        <activity
            android:name=".ui.DiagnosticsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode"
            android:exported="false" />

        <activity
            android:name=".ui.CompatibilityActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode"
            android:exported="false" />

        <activity
            android:name=".ui.UpdateActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode"
            android:exported="false" />

        <activity
            android:name=".ui.RecoveryActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode"
            android:exported="false" />

        <receiver
            android:name=".install.InstallResultReceiver"
            android:exported="false" />

        <provider
            android:name=".diagnostics.DiagnosticShareProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
